# Maintainer: Anthus AI <dev@anthus.ai>
pkgname='antharchy'
pkgver=1.0.0
pkgrel=1
pkgdesc='Beautiful, modern, and agentic Arch Linux desktop distribution by Anthus AI'
arch=('any')
url='https://github.com/AnthusAI/Antharchy'
license=('MIT')
provides=('omarchy=4.0.2')
conflicts=('omarchy' 'omarchy-dev')

depends=(
  "antharchy-settings=${pkgver}"
  'limine'
  'limine-mkinitcpio-hook'
  'limine-snapper-sync'
  'snapper'
  'hyprland'
  'quickshell'
  'uwsm'
  'sddm'
  'xdg-desktop-portal-hyprland'
  'wireplumber'
  'pipewire'
  'gnome-keyring'
  'gum'
  'jq'
  'git'
  'perl'
  'fakeroot'
  'pacman-contrib'
  'ttf-jetbrains-mono-nerd-basic'
)

makedepends=(
  'git'
)

source=()
sha256sums=()

prepare() {
  local src="${ANTHARCHY_SRC:-../..}"
  rm -rf "$srcdir/antharchy"
  mkdir -p "$srcdir/antharchy"
  for item in bin applications config default install migrations shell themes version logo.txt logo.svg icon.txt icon.png; do
    if [[ -e "$src/$item" ]]; then
      cp -a "$src/$item" "$srcdir/antharchy/"
    fi
  done
}

package() {
  cd "$srcdir/antharchy"

  install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/omarchy/bin"
  for bin in bin/*; do
    [[ -f $bin || -L $bin ]] || continue
    local base
    base=$(basename "$bin")
    case "$base" in
      omarchy-debug|omarchy-debug-idle|omarchy-upload-log)
        continue
        ;;
    esac
    install -Dm755 "$bin" "$pkgdir/usr/bin/$base"
    ln -sf "/usr/bin/$base" "$pkgdir/usr/share/omarchy/bin/$base"
  done

  ln -sf omarchy "$pkgdir/usr/bin/antharchy"
  ln -sf omarchy-version "$pkgdir/usr/bin/antharchy-version"

  install -d "$pkgdir/usr/share/omarchy"

  install -Dm644 default/libalpm/hooks/00-omarchy-update-guard.hook "$pkgdir/usr/share/libalpm/hooks/00-omarchy-update-guard.hook" 2>/dev/null || true
  install -Dm644 default/libalpm/hooks/10-omarchy-hyprland-reload-pause.hook "$pkgdir/usr/share/libalpm/hooks/10-omarchy-hyprland-reload-pause.hook" 2>/dev/null || true
  install -Dm644 default/libalpm/hooks/90-omarchy-hyprland-reload-resume.hook "$pkgdir/usr/share/libalpm/hooks/90-omarchy-hyprland-reload-resume.hook" 2>/dev/null || true

  cp -a install "$pkgdir/usr/share/omarchy/"
  cp -a themes "$pkgdir/usr/share/omarchy/"
  cp -a migrations "$pkgdir/usr/share/omarchy/"

  if compgen -G 'migrations/*.sh' >/dev/null; then
    install -d "$pkgdir/etc/skel/.local/state/omarchy/migrations"
    for migration in migrations/*.sh; do
      touch "$pkgdir/etc/skel/.local/state/omarchy/migrations/$(basename "$migration")"
    done
  fi

  cp -a shell "$pkgdir/usr/share/omarchy/"
  install -Dm644 version "$pkgdir/usr/share/omarchy/version"
}
